#!/bin/bash
#
# Daily cron job inside the COmanage container: install the current Let's
# Encrypt certificate when it differs from the one Apache is serving (or when
# the installed one no longer verifies) and reload Apache gracefully.

set -e

LIVE=/etc/letsencrypt/live/roster.cosmicexplorer.org
CONF=/etc/apache2

if cmp -s ${LIVE}/cert.pem ${CONF}/cert.pem \
   && cmp -s ${LIVE}/privkey.pem ${CONF}/privkey.pem \
   && openssl verify -untrusted ${CONF}/ca-chain.pem ${CONF}/cert.pem &>/dev/null; then
  echo "$0 [`date`]: Apache certificate is current."
  exit 0
fi

echo "$0 [`date`]: Installing renewed certificate and reloading apache"
cp -f ${LIVE}/cert.pem      ${CONF}/cert.pem
cp -f ${LIVE}/privkey.pem   ${CONF}/privkey.pem
cp -f ${LIVE}/fullchain.pem ${CONF}/ca-chain.pem
apache2ctl configtest
apache2ctl graceful

exit 0
